{
  "permissions": {
    "allow": [
      "Bash(npm:*)", "Bash(npx:*)", "Bash(node:*)",
      "Bash(git add:*)", "Bash(git commit:*)", "Bash(git push:*)", "Bash(git pull:*)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)",
      "Bash(git stash:*)", "Bash(git fetch:*)", "Bash(git merge:*)",
      "Bash(curl http://localhost:*)", "Bash(sleep:*)", "Bash(lsof:*)", "Bash(kill:*)",
      "Bash(mkdir:*)", "Bash(ls:*)", "Bash(cat:*)", "Bash(grep:*)"
    ],
    "deny": ["Bash(git push --force:*)", "Bash(git reset --hard:*)", "Bash(git rebase:*)", "Bash(rm -rf:*)"]
  }
}
