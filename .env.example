# Copy to .env.local and fill in. Never commit .env.local.
# Razorpay: test keys only (rzp_test_).
RAZORPAY_MODE=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
AI_MODE=
ANTHROPIC_API_KEY=
# Step 5b: ElevenLabs for voice. Set it for live speech-to-text on voice notes
# and generated audio lines on simulated calls; leave it empty for recorded samples.
ELEVENLABS_API_KEY=
# SQLite must live on a persistent, writable volume on one long-running Node server.
# Local default is <repo>/data/ray.db; deployment example: /var/lib/ray/data/ray.db
RAY_DB_PATH=
