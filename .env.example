# Copy to .env.local and fill in. Never commit .env.local.
# Razorpay: test keys only (rzp_test_).
RAZORPAY_MODE=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
AI_MODE=
ANTHROPIC_API_KEY=
# Step 6: the dummy specialist stands in for paid_no_order until Step 7. off turns it off.
RAY_DUMMY_FLOW=
# Step 5b: ElevenLabs for voice. Set it for live speech-to-text on voice notes
# and generated audio lines on simulated calls; leave it empty for recorded samples.
ELEVENLABS_API_KEY=
